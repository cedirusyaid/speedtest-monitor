# ==============================================================================
# Speedtest Monitoring Center - Environment Configuration Template
# ==============================================================================

# Database MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_monitoring
DB_CHARSET=utf8mb4

# Speedtest Engine Parameters
SPEEDTEST_BINARY=speedtest-cli
SPEEDTEST_TIMEOUT=120
SPEEDTEST_LOG_FILE=speedtest.log

# Telegram Notification Settings
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_DAILY_HOUR=9
TELEGRAM_DASHBOARD_URL=http://localhost/speedtest/
